# 参照出力を更新（意図した変更時のみ。reference/ は git 管理外）
update-reference: $(addprefix reference/,$(TARGETS))
# 現在の出力を参照と比較
test: $(foreach file,$(TARGETS),$(file).diff)

NON_7e7fbaba22cf.yaplot.diff: reference/NON_7e7fbaba22cf.yaplot
	@mkdir -p reference
	set -o pipefail; $(GENICE) NON --seed 1 --spot_cation 0=Na --spot_anion 2=Cl --exporter yaplot --spot_guest 0=me --rep 2 2 2 --target_polarization 0 0 4 --density 1.1 2> NON_7e7fbaba22cf.yaplot.log | diff - reference/NON_7e7fbaba22cf.yaplot
	@touch $@

reference/NON_7e7fbaba22cf.yaplot: ../../genice3/unitcell/NON.py ../../genice3/exporter/yaplot.py
	@mkdir -p reference
	$(GENICE) NON --seed 1 --spot_cation 0=Na --spot_anion 2=Cl --exporter yaplot --spot_guest 0=me --rep 2 2 2 --target_polarization 0 0 4 --density 1.1 > $@.tmp 2> $@.log; ec=$$?; if [ $$ec -ne 0 ] || [ ! -s $@.tmp ]; then rm -f $@.tmp; exit 1; fi; mv $@.tmp $@

DDR_c7d62c15c926.cage_survey.diff: reference/DDR_c7d62c15c926.cage_survey
	@mkdir -p reference
	set -o pipefail; $(GENICE) DDR --seed 1 --spot_cation 0=Na --spot_anion 3=Cl --guest A12=me --exporter cage_survey --spot_guest 0=me --depol_loop 2000 --target_polarization 0 0 4 2> DDR_c7d62c15c926.cage_survey.log | diff - reference/DDR_c7d62c15c926.cage_survey
	@touch $@

reference/DDR_c7d62c15c926.cage_survey: ../../genice3/unitcell/DDR.py ../../genice3/exporter/cage_survey.py
	@mkdir -p reference
	$(GENICE) DDR --seed 1 --spot_cation 0=Na --spot_anion 3=Cl --guest A12=me --exporter cage_survey --spot_guest 0=me --depol_loop 2000 --target_polarization 0 0 4 > $@.tmp 2> $@.log; ec=$$?; if [ $$ec -ne 0 ] || [ ! -s $@.tmp ]; then rm -f $@.tmp; exit 1; fi; mv $@.tmp $@

sTprime_2a3a4d0013ac.cage_survey.diff: reference/sTprime_2a3a4d0013ac.cage_survey
	@mkdir -p reference
	set -o pipefail; $(GENICE) sTprime --seed 1 --guest A14=et --exporter cage_survey --depol_loop 2000 2> sTprime_2a3a4d0013ac.cage_survey.log | diff - reference/sTprime_2a3a4d0013ac.cage_survey
	@touch $@

reference/sTprime_2a3a4d0013ac.cage_survey: ../../genice3/unitcell/sTprime.py ../../genice3/exporter/cage_survey.py
	@mkdir -p reference
	$(GENICE) sTprime --seed 1 --guest A14=et --exporter cage_survey --depol_loop 2000 > $@.tmp 2> $@.log; ec=$$?; if [ $$ec -ne 0 ] || [ ! -s $@.tmp ]; then rm -f $@.tmp; exit 1; fi; mv $@.tmp $@

151_2_4949650_68db9e3af672._pol.diff: reference/151_2_4949650_68db9e3af672._pol
	@mkdir -p reference
	set -o pipefail; $(GENICE) 151_2_4949650 --seed 1 --guest A14=et --exporter _pol --target_polarization 0 0 4 2> 151_2_4949650_68db9e3af672._pol.log | diff - reference/151_2_4949650_68db9e3af672._pol
